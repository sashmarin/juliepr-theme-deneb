{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"palette": [
				{
					"color": "#ffffff",
					"name": "White",
					"slug": "white"
				},
				{
					"color": "#000000",
					"name": "Black",
					"slug": "black"
				},
				{
					"color": "#3c3c3c",
					"name": "Dark Grey",
					"slug": "dark-grey"
				},
				{
					"color": "#c8c8c8",
					"name": "Light Grey",
					"slug": "light-grey"
				},
				{
					"color": "#808080",
					"name": "Grey",
					"slug": "grey"
				},
				{
					"color": "#f0f0f0",
					"name": "Almost White",
					"slug": "almost-white"
				},
				{
					"color": "#303030",
					"name": "Almost Black",
					"slug": "almost-black"
				}
			]
		},
		"layout": {
			"contentSize": "1024px",
			"wideSize": "1280px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Tiny",
					"size": "3px",
					"slug": "tiny"
				},
				{
					"name": "X-Small",
					"size": "8px",
					"slug": "x-small"
				},
				{
					"name": "Small",
					"size": "18px",
					"slug": "small"
				},
				{
					"name": "Regular",
					"size": "clamp(20px, 3vw, 40px)",
					"slug": "regular"
				},
				{
					"name": "Large",
					"size": "clamp(30px, 5vw, 60px)",
					"slug": "large"
				},
				{
					"name": "X-Large",
					"size": "clamp(50px, 7vw, 80px)",
					"slug": "x-large"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"writingMode": true,
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{
					"fluid": false,
					"name": "Small",
					"size": "0.8em",
					"slug": "small"
				},
				{
					"fluid": {
						"max": "1.1em",
						"min": "1em"
					},
					"name": "Medium",
					"size": "1.1em",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "1.5em",
						"min": "1.2em"
					},
					"name": "Large",
					"size": "1.5em",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "2em",
						"min": "1.75em"
					},
					"name": "Extra Large",
					"size": "2em",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "2.5rem",
						"min": "2.1rem"
					},
					"name": "Extra Extra Large",
					"size": "2.5rem",
					"slug": "xx-large"
				}
			],
			"fontFamilies": [
				{
					"name": "Inter",
					"slug": "text",
					"fontFamily": "Inter, sans-serif",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/Inter-VariableFont_opsz_wght.woff2"
							],
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontFamily": "Inter"
						}
					]
				},
				{
					"name": "Fira Code",
					"slug": "code",
					"fontFamily": "Fira Code, monospace",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/FiraCode-VariableFont_wght.woff2"
							],
							"fontWeight": "300 700",
							"fontStyle": "normal",
							"fontFamily": "Fira Code"
						}
					]
				},
				{
					"name": "Bodoni Moda",
					"slug": "logo",
					"fontFamily": "Bodoni Moda",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/BodoniModa-VariableFont_opsz_wght.woff2"
							],
							"fontWeight": "400 900",
							"fontStyle": "normal",
							"fontFamily": "Bodoni Moda"
						}
					]
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"text": "var:preset|color|black",
			"background": "var:preset|color|white"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|text",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "1.625"
		},
		"elements": {
			"heading": {
				"typography": {
					"lineHeight": "1.4",
					"fontWeight": "500"
				}
			},
			"link": {
				"typography": {
					"textDecoration": "underline"
				},
				"color": {
					"text": "var:preset|color|black"
				}
			},
			"button": {
				"typography": {
					"fontFamily": "var:preset|font-family|code"
				},
				"spacing": {
					"padding": {
						"top": "0.6em",
						"right": "0.8em",
						"bottom": "0.6em",
						"left": "0.8em"
					}
				},
				"color": {
					"background": "var:preset|color|black",
					"text": "var:preset|color|white"
				},
				"border": {
					"radius": "0px",
					"color": "var:preset|color|black"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|dark-grey"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "300"
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"typography": {
					"textAlign": "justify"
				}
			},
			"core/group": {
				"border": {
					"color": "var:preset|color|light-grey"
				}
			},
			"core/columns": {
				"border": {
					"color": "var:preset|color|light-grey"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|logo",
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "700"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/navigation": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var:preset|font-family|code",
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "300"
				}
			}
		}
	}
}
